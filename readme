        C[("MinIO<br/>Données brutes")]
        B --> C
    end

    subgraph SILVER["🥈 Silver — Nettoyage"]
        D["Pandas<br/>Nettoyage et dédoublonnage"]
        E[("PostgreSQL<br/>Données nettoyées")]
        D --> E
    end

    subgraph GOLD["🥇 Gold — Data Warehouse"]
        F["dbt<br/>Transformations SQL"]
        G[("dim_clients")]
        H[("dim_produits")]
        I[("fact_sales")]
        J[("fact_stocks")]
        F --> G
        F --> H
        F --> I
        F --> J
    end

    subgraph BI["📊 Business Intelligence"]
        K["Power BI<br/>Dashboards interactifs"]
    end

    A --> B
    C --> D
    E --> F
    G --> K
    H --> K
    I --> K
    J --> K

    L["Apache Airflow<br/>Orchestration du pipeline"]

    L -.-> B
    L -.-> D
    L -.-> F

    classDef bronze fill:#CD7F32,color:#fff,stroke:#8C5523
    classDef silver fill:#A7B0B7,color:#111,stroke:#6C757D
    classDef gold fill:#D4AF37,color:#111,stroke:#9A7B16
